{%- comment -%}
  sections/mipileta-home.liquid — Home de marca de Mi Pileta.
  GENERADO por build-shopify.js a partir de mipileta-home.html. No editar a mano:
  los cambios se hacen en el HTML y se vuelve a correr `node build-shopify.js`.
{%- endcomment -%}
{%- if section.settings.hero_img != blank -%}
  {%- assign img_hero_img = section.settings.hero_img | image_url: width: 2400 -%}
{%- else -%}
  {%- assign img_hero_img = 'home-hero-acero.png' | asset_img_url: '2400x' -%}
{%- endif -%}
{%- if section.settings.logo != blank -%}
  {%- assign img_logo = section.settings.logo | image_url: width: 900 -%}
{%- else -%}
  {%- assign img_logo = 'logo-negro.png' | asset_img_url: '900x' -%}
{%- endif -%}
{%- if section.settings.logo_pie != blank -%}
  {%- assign img_logo_pie = section.settings.logo_pie | image_url: width: 900 -%}
{%- else -%}
  {%- assign img_logo_pie = 'logo-blanco.png' | asset_img_url: '900x' -%}
{%- endif -%}
{%- if section.settings.l1_img != blank -%}
  {%- assign img_l1_img = section.settings.l1_img | image_url: width: 1800 -%}
{%- else -%}
  {%- assign img_l1_img = 'familia-essentia-3.jpg' | asset_img_url: '1800x' -%}
{%- endif -%}
{%- if section.settings.l2_img != blank -%}
  {%- assign img_l2_img = section.settings.l2_img | image_url: width: 1800 -%}
{%- else -%}
  {%- assign img_l2_img = 'zingara-hero-cobre.png' | asset_img_url: '1800x' -%}
{%- endif -%}
{%- if section.settings.l3_img != blank -%}
  {%- assign img_l3_img = section.settings.l3_img | image_url: width: 1600 -%}
{%- else -%}
  {%- assign img_l3_img = 'ess-lifestyle.jpg' | asset_img_url: '1600x' -%}
{%- endif -%}
{%- if section.settings.marca_img != blank -%}
  {%- assign img_marca_img = section.settings.marca_img | image_url: width: 1400 -%}
{%- else -%}
  {%- assign img_marca_img = 'home-marca.jpg' | asset_img_url: '1400x' -%}
{%- endif -%}
{%- if section.settings.p1_img != blank -%}
  {%- assign img_p1_img = section.settings.p1_img | image_url: width: 900 -%}
{%- else -%}
  {%- assign img_p1_img = 'home-post-cocina.jpg' | asset_img_url: '900x' -%}
{%- endif -%}
{%- if section.settings.p2_img != blank -%}
  {%- assign img_p2_img = section.settings.p2_img | image_url: width: 900 -%}
{%- else -%}
  {%- assign img_p2_img = 'home-post-tabla.jpg' | asset_img_url: '900x' -%}
{%- endif -%}
{%- if section.settings.p3_img != blank -%}
  {%- assign img_p3_img = section.settings.p3_img | image_url: width: 900 -%}
{%- else -%}
  {%- assign img_p3_img = 'zingara-hero.png' | asset_img_url: '900x' -%}
{%- endif -%}

<style>
  :root{
    --vw:100vw;
    --fixoff:0px;
    --bg:#ffffff;
    --nav:#ffffff;
    --card:#f7f7f5;
    --line:#e4e4e0;
    --txt:#14181e;
    --muted:#5f656c;
    --warm:#b07a41;          /* firma cálida de la marca madre (las líneas van frías) */
    --dark:#0c0d0f;          /* las islas oscuras: banner, Calidad, pie, fotos */
    --ink:#14181e;
    --radius:30px;
    --steel:linear-gradient(180deg,#ffffff 0%,#d6dbe1 16%,#9aa1aa 38%,#676d76 50%,#b3bac3 62%,#f2f5f8 84%,#c2c9d1 100%);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;overflow-x:hidden;overflow-x:clip;}
  body{
    margin:0;background:var(--bg);color:var(--txt);
    font-family:"Hanken Grotesk",system-ui,Arial,sans-serif;
    font-weight:400;line-height:1.55;-webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  h1,h2,h3,h4{margin:0;font-weight:400;line-height:1.06;}
  .container{max-width:1180px;margin:0 auto;padding:0 20px;}
  .section{padding-block:clamp(56px,8vw,104px);}
  #lineas,#catalogo,#calidad,#compra,#inspileta,#donde-comprar,#newsletter,#contacto{scroll-margin-top:84px;}

  /* ---------- helpers ---------- */
  .eyebrow{
    font-size:.78rem;letter-spacing:.3em;color:var(--muted);
    text-transform:uppercase;font-weight:400;
  }
  .center{text-align:center;}
  .lead{color:var(--muted);font-weight:300;max-width:660px;}
  .center .lead{margin-left:auto;margin-right:auto;}
  h2.title{
    font-family:"Raleway",sans-serif;font-weight:200;
    font-size:clamp(2rem,4.6vw,3.4rem);letter-spacing:.01em;margin:16px 0 0;
  }
  h2.title strong{font-weight:700;}
  .btn{
    display:inline-block;padding:14px 30px;border-radius:99px;font-weight:700;
    cursor:pointer;font-family:inherit;border:1px solid transparent;font-size:.92rem;
    transition:background .25s ease,border-color .25s ease,color .25s ease;
  }
  /* por defecto, sobre fondo claro */
  .btn-metal{color:#fff;background:var(--ink);border-color:var(--ink);}
  .btn-metal:hover{background:transparent;color:var(--ink);}
  .btn-outline{background:none;border-color:rgba(20,24,30,.3);color:var(--ink);}
  .btn-outline:hover{border-color:var(--ink);background:var(--ink);color:#fff;}
  .btn-ink{color:var(--ink);background:#fff;border-color:#fff;}
  .btn-ink:hover{background:transparent;color:#fff;border-color:#fff;}
  /* dentro de las islas oscuras se invierten */
  .hero .btn-metal,.paper .btn-metal,.contacto .btn-metal{background:#fff;color:var(--ink);border-color:#fff;}
  .hero .btn-metal:hover,.paper .btn-metal:hover,.contacto .btn-metal:hover{background:transparent;color:#fff;}
  .hero .btn-outline,.contacto .btn-outline{border-color:rgba(255,255,255,.45);color:#e9ecef;}
  .hero .btn-outline:hover,.contacto .btn-outline:hover{border-color:#fff;background:#fff;color:var(--ink);}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;}
  .center .cta-row,.cta-row.center{justify-content:center;}
  .arrow{transition:transform .3s ease;display:inline-block;}

  /* aparición al scrollear */
  .rv{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s cubic-bezier(.22,.61,.36,1);}
  .rv.in{opacity:1;transform:none;}
  @media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none;}}

  /* ---------- nav ---------- */
  .topbar{position:sticky;top:0;z-index:60;background:var(--nav);padding:11px 0;
    border-bottom:1px solid var(--line);}
  .topbar .inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;position:relative;}
  .topbar .logo{height:42px;width:auto;}
  .topbar nav{display:flex;gap:1.7rem;align-items:center;}
  .topbar nav a{font-size:.98rem;font-weight:400;color:var(--ink);opacity:.78;transition:opacity .2s;}
  .topbar nav a:hover{opacity:1;}
  .nav-shop{
    background:var(--ink);color:#fff !important;border:1px solid var(--ink);border-radius:99px;padding:9px 20px;
    font-size:.85rem !important;font-weight:700 !important;opacity:1 !important;
    transition:background .25s,color .25s,border-color .25s;
  }
  .nav-shop:hover{background:transparent;color:var(--ink) !important;}
  .hamburger{display:none;flex-direction:column;justify-content:center;gap:6px;
    background:none;border:0;cursor:pointer;padding:8px;width:44px;height:44px;}
  .hamburger span{display:block;width:26px;height:2px;background:var(--ink);border-radius:2px;
    transition:transform .3s ease,opacity .3s ease;}
  @media(max-width:1060px){
    .topbar .logo{height:36px;}
    .hamburger{display:flex;}
    .topbar nav{
      display:none;position:absolute;top:calc(100% + 11px);left:0;right:0;z-index:70;
      flex-direction:column;gap:0;align-items:stretch;background:var(--nav);
      border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:6px 0;
    }
    .topbar.nav-open nav{display:flex;}
    .topbar nav a{padding:15px 20px;font-size:1.05rem;opacity:1;}
    .nav-shop{margin:10px 20px 14px;text-align:center;}
    .topbar.nav-open .hamburger span:nth-child(1){transform:translateY(8px) rotate(45deg);}
    .topbar.nav-open .hamburger span:nth-child(2){opacity:0;}
    .topbar.nav-open .hamburger span:nth-child(3){transform:translateY(-8px) rotate(-45deg);}
  }

  /* ---------- hero: banner unico ---------- */
  /* la foto es apaisada y tiene la mesada vacia a la izquierda: el texto va ahi,
     igual que en el banner del sitio actual, y el velo lo hace legible */
  .hero{
    position:relative;min-height:calc(100svh - 110px);
    display:flex;align-items:center;overflow:hidden;background:#000;
  }
  /* una sola foto de banner */
  .hero-slides{
    position:absolute;inset:0;z-index:0;
    transform:scale(1.06);
    transition:transform 1.6s cubic-bezier(.22,.61,.36,1);
  }
  .hero.on .hero-slides{transform:scale(1);}
  .hero-slide{
    position:absolute;inset:0;opacity:0;
    background-size:cover;background-repeat:no-repeat;
    transition:opacity 1.5s ease;
  }
  .hero-slide.is-on{opacity:1;}
  .hero-slide--1{background-image:url('{{ img_hero_img }}');background-position:center 64%;}
  .hero::after{
    content:"";position:absolute;inset:0;z-index:1;
    background:
      radial-gradient(46% 54% at 54% 56%,rgba(255,255,255,.13) 0%,rgba(255,255,255,.05) 48%,transparent 68%),
      radial-gradient(88% 92% at 54% 56%,transparent 38%,rgba(0,0,0,.66) 100%),
      linear-gradient(180deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.42) 32%,rgba(0,0,0,.12) 60%,rgba(0,0,0,.35) 100%),
      linear-gradient(90deg,rgba(0,0,0,.8) 0%,rgba(0,0,0,.52) 20%,rgba(0,0,0,.2) 36%,transparent 54%);
  }
  .hero-copy{position:relative;z-index:2;width:100%;
    padding-top:0;padding-bottom:clamp(30px,9vh,110px);}
  .hero-copy .container{max-width:1180px;}
  .hero h1{
    color:#fff;
    font-family:"Raleway",sans-serif;font-weight:200;
    font-size:clamp(2.2rem,5.4vw,4.4rem);line-height:1.04;letter-spacing:.005em;
    max-width:20ch;text-shadow:0 2px 24px rgba(0,0,0,.55);
  }
  /* sobre foto oscura el acero completo se apaga: acá va una versión más clara */
  .hero h1 em{font-style:normal;font-weight:700;
    background:linear-gradient(180deg,#ffffff 0%,#eaeef2 28%,#bcc3cc 56%,#eff3f7 78%,#d2d9e1 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .hero .sub{color:#d6dae0;font-weight:300;max-width:44ch;margin:20px 0 0;
    font-size:clamp(1rem,1.5vw,1.15rem);text-shadow:0 1px 12px rgba(0,0,0,.6);}
  .hero .cta-row{margin-top:32px;}

  .scroll-hint{
    position:absolute;left:50%;transform:translateX(-50%);bottom:96px;z-index:2;
    width:1px;height:44px;background:linear-gradient(180deg,rgba(255,255,255,.7),transparent);
    animation:hint 2.4s ease-in-out infinite;
  }
  @keyframes hint{0%,100%{opacity:.25;height:30px}50%{opacity:.9;height:52px}}
  @media(max-width:760px){
    /* en vertical la mesada vacía se pierde: encuadramos sobre la pileta y
       el velo pasa a ser de arriba hacia abajo */
    .hero{min-height:min(76svh,600px);}
    /* en vertical entra poco ancho: encuadramos donde estan las manos y la tabla,
       que es lo que le da vida, y no sobre la cuba vacia */
    .hero-slide{background-position:center 60%;}
    .hero::after{
      background:
        radial-gradient(58% 42% at 60% 58%,rgba(255,255,255,.12) 0%,transparent 66%),
        radial-gradient(95% 85% at 60% 58%,transparent 34%,rgba(0,0,0,.62) 100%),
        linear-gradient(180deg,rgba(0,0,0,.8) 0%,rgba(0,0,0,.42) 44%,rgba(0,0,0,.55) 100%);
    }
    .hero-copy{padding-bottom:40px;}
    .hero h1{max-width:none;}
    .hero .sub{max-width:none;}
    .scroll-hint{display:none;}
  }

  /* ---------- marquee de pilares ---------- */
  .strip{border-block:1px solid var(--line);background:#f3f3f1;overflow:hidden;padding:16px 0;}
  .strip-track{display:flex;gap:0;width:max-content;animation:slide 38s linear infinite;}
  .strip-track span{
    display:flex;align-items:center;gap:26px;padding-right:26px;white-space:nowrap;
    font-size:.74rem;letter-spacing:.28em;text-transform:uppercase;color:#6b7178;
  }
  .strip-track span::after{content:"";width:5px;height:5px;border-radius:50%;background:var(--warm);opacity:.8;}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .strip:hover .strip-track{animation-play-state:paused;}

  /* ---------- las líneas ---------- */
  .lineas-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:46px;}
  .linea{
    position:relative;display:block;border-radius:var(--radius);overflow:hidden;
    background:var(--card);border:1px solid var(--line);
    transition:border-color .4s ease,transform .5s cubic-bezier(.22,.61,.36,1);
  }
  .linea:hover{border-color:#c9c9c4;transform:translateY(-4px);}
  .linea-media{position:relative;aspect-ratio:4/3;overflow:hidden;background:#000;}
  .linea-media img{width:100%;height:100%;object-fit:cover;
    transition:transform 1.1s cubic-bezier(.22,.61,.36,1),filter .6s ease;filter:brightness(.85);}
  .linea:hover .linea-media img{transform:scale(1.05);filter:brightness(1);}
  .linea-media::after{content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.85) 100%);}
  .linea-badge{
    position:absolute;top:18px;left:18px;z-index:2;
    font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:#e9ecef;
    background:rgba(0,0,0,.42);border:1px solid rgba(255,255,255,.32);
    backdrop-filter:blur(6px);border-radius:99px;padding:6px 14px;
  }
  .linea-name{
    position:absolute;left:26px;bottom:22px;z-index:2;
    font-family:"Raleway",sans-serif;font-weight:300;letter-spacing:.2em;
    font-size:clamp(1.5rem,2.6vw,2.1rem);text-transform:uppercase;
    background:var(--steel);-webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .linea-body{padding:24px 26px 28px;}
  .linea-body p{margin:0;color:var(--muted);font-weight:300;font-size:.98rem;}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
  .chip{
    font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:#4a5057;
    border:1px solid var(--line);border-radius:99px;padding:5px 12px;
  }
  .linea-go{
    display:inline-flex;align-self:flex-start;align-items:center;gap:9px;margin-top:20px;
    font-size:.85rem;font-weight:700;letter-spacing:.04em;
    border-bottom:1px solid rgba(20,24,30,.28);padding-bottom:4px;
  }
  .linea:hover .linea-go .arrow{transform:translateX(6px);}
  /* la tercera es ancha: accesorios no es una línea, es lo que la completa */
  .linea--wide{grid-column:1 / -1;display:grid;grid-template-columns:1.05fr 1fr;align-items:stretch;}
  .linea--wide .linea-media{aspect-ratio:auto;min-height:290px;}
  .linea--wide .linea-body{display:flex;flex-direction:column;justify-content:center;padding:36px 40px;}
  .linea--wide .linea-name{position:static;display:block;margin-bottom:12px;font-size:clamp(1.4rem,2.2vw,1.8rem);
    background:none;-webkit-text-fill-color:currentColor;color:var(--ink);}
  @media(max-width:860px){
    .lineas-grid{grid-template-columns:1fr;}
    .linea--wide{grid-template-columns:1fr;}
    .linea--wide .linea-media{min-height:220px;aspect-ratio:16/10;}
    .linea--wide .linea-body{padding:24px 26px 28px;}
  }

  /* ---------- categorias que no son "linea" pero tienen que estar ---------- */
  /* van despues de las lineas y en un peso visual menor a proposito:
     lavadero, piletones y repuestos no compiten con Essentia y Zingara */
  .extras-head{display:flex;align-items:center;gap:18px;margin:46px 0 18px;}
  .extras-head::before,.extras-head::after{content:"";flex:1;height:1px;background:var(--line);}
  .extras-head span{font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;color:#6b7178;}
  .extras{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
  .extra{
    display:flex;gap:16px;align-items:stretch;
    background:var(--card);border:1px solid var(--line);border-radius:22px;padding:22px 24px;
    transition:border-color .35s ease,transform .5s cubic-bezier(.22,.61,.36,1);
  }
  .extra:hover{border-color:#c9c9c4;transform:translateY(-3px);}
  .extra svg{flex:0 0 auto;align-self:flex-start;width:26px;height:26px;stroke:var(--ink);fill:none;stroke-width:1.2;margin-top:3px;}
  /* la columna de texto crece para que los "Ver…" queden alineados aunque las
     descripciones tengan distinta cantidad de renglones */
  .extra > div{display:flex;flex-direction:column;flex:1;}
  .extra b{display:block;font-size:1rem;font-weight:700;}
  .extra p{margin:5px 0 0;color:var(--muted);font-size:.87rem;font-weight:300;}
  .extra .linea-go{margin-top:auto;padding-top:16px;font-size:.78rem;align-self:flex-start;}
  @media(max-width:860px){.extras{grid-template-columns:1fr;}}

  /* ---------- catalogo ---------- */
  /* las fotos de producto vienen sobre negro o recortadas, asi que las cajas
     van en negro puro y la pieza flota: no hay recuadro blanco que rompa */
  .cat-head{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;flex-wrap:wrap;margin-top:40px;}
  .cat-filtros{display:flex;gap:8px;flex-wrap:wrap;}
  .cat-filtro{
    border:1px solid var(--line);border-radius:99px;padding:9px 20px;
    font-family:inherit;font-size:.8rem;letter-spacing:.04em;color:#4a5057;
    background:none;cursor:pointer;
    transition:background .25s,border-color .25s,color .25s;
  }
  .cat-filtro:hover{border-color:#b9b9b3;color:var(--ink);}
  .cat-filtro.on{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:700;}
  .cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:30px;}
  .prod{
    display:block;border:1px solid var(--line);border-radius:22px;overflow:hidden;
    background:var(--card);
    transition:border-color .35s ease,transform .5s cubic-bezier(.22,.61,.36,1);
  }
  .prod:hover{border-color:#c9c9c4;transform:translateY(-4px);}
  .prod-media{position:relative;aspect-ratio:1/1;background:#000;overflow:hidden;}
  .prod-media img{
    width:100%;height:100%;object-fit:contain;padding:9%;
    transition:transform .8s cubic-bezier(.22,.61,.36,1);
  }
  .prod:hover .prod-media img{transform:scale(1.07);}
  .prod-body{padding:15px 18px 19px;border-top:1px solid var(--line);}
  .prod-body b{display:block;font-size:.93rem;font-weight:700;}
  .prod-body span{display:block;font-size:.76rem;color:var(--muted);margin-top:3px;letter-spacing:.02em;}
  @media(max-width:980px){.cat-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){
    .cat-head{flex-direction:column;align-items:flex-start;}
    .cat-grid{grid-template-columns:repeat(2,1fr);gap:12px;}
    .prod-body{padding:12px 14px 16px;}
    .prod-body b{font-size:.85rem;}
  }

  /* ---------- franja clara: la marca ---------- */
  /* el quiebre a claro es exclusivo de la home; las landings de línea son 100% negras */
  .paper{background:var(--dark);color:#fff;}
  .paper .eyebrow{color:#9aa1aa;}
  .paper .lead{color:#b5b5b5;}
  .marca-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:center;}
  .marca-txt h2{font-family:"Raleway",sans-serif;font-weight:200;
    font-size:clamp(1.9rem,3.8vw,3rem);margin:16px 0 20px;}
  .marca-txt h2 strong{font-weight:700;}
  .marca-txt p{color:#b5b5b5;font-weight:300;margin:0 0 18px;}
  .marca-foto{border-radius:var(--radius);overflow:hidden;aspect-ratio:4/5;background:#1a1b1e;}
  .marca-foto img{width:100%;height:100%;object-fit:cover;}
  .facts{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#26282c;
    border:1px solid #26282c;border-radius:18px;overflow:hidden;margin-top:26px;}
  .fact{background:var(--dark);padding:20px 20px 22px;}
  .fact svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:1.3;margin-bottom:10px;}
  .fact b{display:block;font-size:.95rem;font-weight:700;letter-spacing:.02em;}
  .fact span{display:block;font-size:.85rem;color:#9aa1aa;font-weight:300;margin-top:3px;}
  @media(max-width:860px){
    .marca-grid{grid-template-columns:1fr;}
    .marca-foto{aspect-ratio:16/11;order:-1;}
  }

  /* ---------- compra protegida ---------- */
  .cards4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:44px;}
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:22px;padding:26px 22px 28px;
    transition:border-color .35s ease,background .35s ease;
  }
  .card:hover{border-color:#c9c9c4;background:#f1f1ee;}
  .card svg{width:26px;height:26px;stroke:var(--ink);fill:none;stroke-width:1.2;margin-bottom:14px;}
  .card b{display:block;font-size:1rem;font-weight:700;}
  .card p{margin:6px 0 0;color:var(--muted);font-size:.9rem;font-weight:300;}
  @media(max-width:900px){.cards4{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.cards4{grid-template-columns:1fr;}}

  /* ---------- inspileta ---------- */
  .posts{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px;}
  .post{border-radius:22px;overflow:hidden;background:var(--card);border:1px solid var(--line);
    transition:border-color .35s ease,transform .5s cubic-bezier(.22,.61,.36,1);}
  .post:hover{border-color:#c9c9c4;transform:translateY(-4px);}
  .post-media{aspect-ratio:16/10;overflow:hidden;background:var(--dark);}
  .post-media img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:brightness(.88);
    transition:transform 1s cubic-bezier(.22,.61,.36,1),filter .5s;}
  .post:hover .post-media img{transform:scale(1.05);filter:brightness(1);}
  .post-body{padding:20px 22px 24px;}
  .post-body span{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--warm);}
  .post-body h3{font-size:1.05rem;font-weight:400;line-height:1.35;margin-top:10px;}
  @media(max-width:900px){.posts{grid-template-columns:1fr;}}

  /* ---------- donde comprar (portado de la landing de Essentia) ---------- */
  .locator{
    margin-top:40px;display:grid;grid-template-columns:0.85fr 1.15fr;gap:0;
    border-radius:22px;overflow:hidden;
    background:var(--card);border:1px solid var(--line);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    box-shadow:0 24px 60px rgba(20,24,30,.1);
  }
  .loc-side{padding:34px 30px;display:flex;flex-direction:column;}
  .loc-title{font-size:1.6rem;font-weight:400;margin:0 0 8px;}
  .loc-sub{color:var(--muted);font-weight:300;margin:0 0 20px;font-size:.95rem;}
  .loc-form{display:flex;gap:10px;margin-bottom:18px;}
  .loc-form input{
    flex:1;background:#fff;border:1px solid var(--line);
    border-radius:10px;color:var(--ink);padding:12px 16px;font-family:inherit;font-size:.95rem;outline:none;
  }
  .loc-form input::placeholder{color:#9aa0a6;}
  .loc-form input:focus{border-color:var(--ink);}
  .loc-go{padding:12px 22px;font-size:.9rem;}
  .loc-results{overflow-y:auto;max-height:330px;padding-right:6px;}
  .loc-hint,.loc-none{color:#7e7e7e;font-weight:300;font-size:.9rem;margin:0;}
  .loc-zone{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:#6b7178;margin:4px 0 10px;}
  .loc-card{border-top:1px solid var(--line);padding:14px 0;}
  .loc-card.cerca h4::after{
    content:"El más cercano";margin-left:10px;font-size:.62rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--warm);font-weight:400;vertical-align:middle;
  }
  .loc-card h4{font-size:1rem;font-weight:700;margin:0 0 4px;}
  .loc-card p{margin:0;color:var(--muted);font-weight:300;font-size:.85rem;line-height:1.4;}
  .loc-card a{color:var(--ink);font-size:.85rem;text-decoration:underline;}
  .loc-map{position:relative;min-height:460px;background:radial-gradient(circle at 35% 25%,#ececea,#e0e0dc 75%);overflow:hidden;}
  .loc-streets{position:absolute;inset:0;width:100%;height:100%;}
  .loc-streets g{stroke:#dcdcd7;}
  .loc-map-empty{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    color:#9aa0a6;font-size:.8rem;letter-spacing:.18em;text-transform:uppercase;
  }
  .loc-pins{position:absolute;inset:0;}
  .loc-pin{
    position:absolute;transform:translate(-50%,-100%);
    width:24px;height:24px;border-radius:50% 50% 50% 0;rotate:-45deg;
    background:linear-gradient(135deg,#5b636d,#2f353c 55%,#14181e);
    box-shadow:0 6px 16px rgba(20,24,30,.35);animation:pin-drop .4s ease both;
  }
  .loc-pin.cerca{background:linear-gradient(135deg,#f3d9bd,#c9925a 60%,#8d5f33);width:28px;height:28px;}
  .loc-pin::after{content:"";position:absolute;inset:7px;background:#fff;border-radius:50%;}
  @keyframes pin-drop{from{opacity:0;transform:translate(-50%,-160%);}to{opacity:1;transform:translate(-50%,-100%);}}
  @media(max-width:820px){
    .locator{grid-template-columns:1fr;}
    .loc-side{padding:26px 22px;}
    .loc-title{font-size:1.4rem;}
    .loc-form{flex-direction:column;}
    .loc-go{width:100%;}
    .loc-map{min-height:340px;}
  }

  /* ---------- newsletter ---------- */
  .news{
    border:1px solid var(--line);border-radius:var(--radius);background:var(--card);
    padding:clamp(34px,5vw,58px) clamp(24px,5vw,58px);
  }
  .news h2{font-family:"Raleway",sans-serif;font-weight:200;
    font-size:clamp(1.7rem,3.2vw,2.5rem);margin:14px 0 0;}
  .news .lead{margin:16px 0 0;max-width:62ch;}
  .news-form{margin-top:28px;}
  .news-perfiles{display:flex;flex-wrap:wrap;gap:10px;}
  /* el radio real queda oculto pero navegable por teclado: el foco se ve en el chip */
  .perfil input{position:absolute;opacity:0;width:0;height:0;}
  .perfil span{
    display:inline-block;cursor:pointer;background:#fff;
    border:1px solid var(--line);border-radius:99px;padding:9px 18px;
    font-size:.85rem;color:#4a5057;transition:background .25s,border-color .25s,color .25s;
  }
  .perfil span:hover{border-color:#b9b9b3;color:var(--ink);}
  .perfil input:checked + span{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:700;}
  .perfil input:focus-visible + span{outline:2px solid var(--warm);outline-offset:2px;}
  .news-row{display:flex;gap:12px;margin-top:16px;flex-wrap:wrap;}
  .news-row input{
    flex:1;min-width:240px;background:#fff;border:1px solid var(--line);
    border-radius:99px;color:var(--ink);padding:14px 22px;font-family:inherit;font-size:.95rem;outline:none;
  }
  .news-row input::placeholder{color:#9aa0a6;}
  .news-row input:focus{border-color:var(--ink);}
  .news-msg{margin:14px 0 0;font-size:.9rem;color:var(--warm);min-height:1.2em;}

  /* ---------- contacto ---------- */
  .contacto{
    position:relative;border-radius:var(--radius);overflow:hidden;
    border:1px solid var(--dark);background:var(--dark);color:#fff;
    padding:clamp(40px,6vw,72px) clamp(24px,5vw,64px);text-align:center;
  }
  .contacto::before{
    content:"";position:absolute;inset:0;
    background:radial-gradient(70% 120% at 50% 0%,rgba(201,146,90,.2),transparent 60%);
  }
  .contacto > *{position:relative;}
  .contacto h2{font-family:"Raleway",sans-serif;font-weight:200;
    font-size:clamp(1.8rem,3.6vw,2.8rem);margin:14px 0 0;}
  .contacto .eyebrow{color:#9aa1aa;}
  .contacto .lead{color:#b5b5b5;}

  /* ---------- footer ---------- */
  footer{background:var(--dark);color:#fff;padding:56px 0 34px;margin-top:20px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;}
  .foot-grid img{height:38px;width:auto;margin-bottom:16px;}
  .foot-grid h4{font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;color:#8b9198;margin-bottom:14px;}
  .foot-grid a{color:#b5b5b5;}
  .foot-grid a{display:block;color:var(--muted);font-size:.92rem;font-weight:300;padding:4px 0;transition:color .2s;}
  .foot-grid a:hover{color:#fff;}
  .foot-grid p{color:#b5b5b5;font-size:.9rem;font-weight:300;margin:0;max-width:34ch;}
  .social{display:flex;gap:12px;margin-top:16px;}
  .social a{width:36px;height:36px;border:1px solid #2a2c30;border-radius:50%;
    display:flex;align-items:center;justify-content:center;padding:0;transition:background .25s,border-color .25s;}
  .social svg{width:16px;height:16px;fill:#c8ced6;transition:fill .25s;}
  .social a:hover{background:#fff;border-color:#fff;}
  .social a:hover svg{fill:var(--ink);}
  .foot-bottom{border-top:1px solid #2a2c30;margin-top:40px;padding-top:20px;
    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
    color:#7d838a;font-size:.8rem;font-weight:300;}
  @media(max-width:860px){.foot-grid{grid-template-columns:1fr 1fr;gap:26px;}}
  @media(max-width:520px){.foot-grid{grid-template-columns:1fr;}}

  /* ---------- WhatsApp flotante (mismo lenguaje que las landings de línea) ---------- */
  .float-wsp{
    position:fixed;right:calc(22px - var(--fixoff,0px));bottom:22px;z-index:900;
    width:46px;height:46px;border-radius:50%;background:var(--ink);
    border:1px solid var(--ink);backdrop-filter:blur(6px);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 6px 20px rgba(0,0,0,.45);
    transition:background .25s ease,border-color .25s ease;
  }
  .float-wsp svg{width:22px;height:22px;fill:#fff;transition:fill .25s ease;}
  .float-wsp:hover{background:#fff;border-color:var(--ink);}
  .float-wsp:hover svg{fill:var(--ink);}
  @media(max-width:640px){
    .float-wsp{right:14px;bottom:calc(18px + env(safe-area-inset-bottom,0px));}
  }
</style>
