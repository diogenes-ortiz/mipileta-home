        {n:'Distribuidora Centro', a:'Rojas 380, Caballito, CABA', t:'11 4431 1212', x:26, y:78}
      ]},
      recoleta: { label:'Recoleta', puntos:[
        {n:'Premium Living', a:'Av. Callao 1180, Recoleta, CABA', t:'11 4811 6600', x:55, y:42},
        {n:'Deco Recoleta', a:'Av. Las Heras 2240, Recoleta, CABA', t:'11 4805 9999', x:62, y:48},
        {n:'Casa Norte', a:'Junín 1450, Recoleta, CABA', t:'11 4807 3030', x:50, y:38}
      ]}
    };
    var res = document.getElementById('loc-results');
    var pins = document.getElementById('loc-pins');
    var vacio = document.getElementById('loc-map-empty');
    function norm(t){ return (t||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim(); }
    function buscar(q){
      q = norm(q); if(!q) return null;
      for(var k in ZONAS){ if(q.indexOf(k) !== -1 || k.indexOf(q) !== -1) return k; }
      return null;
    }
    function pintar(q){
      var k = buscar(q);
      pins.innerHTML = '';
      if(!k){
        res.innerHTML = '<p class="loc-none">No encontramos esa zona. Probá con: Palermo, Belgrano, Caballito o Recoleta.</p>';
        vacio.style.display = 'flex';
        return;
      }
      var z = ZONAS[k];
      vacio.style.display = 'none';
      res.innerHTML = '<p class="loc-zone">' + z.puntos.length + ' puntos de venta · ' + z.label + '</p>' +
        z.puntos.map(function(p, i){
          return '<div class="loc-card' + (i === 0 ? ' cerca' : '') + '">' +
                 '<h4>' + p.n + '</h4><p>' + p.a + '</p>' +
                 '<a href="tel:' + p.t.replace(/\s/g,'') + '">' + p.t + '</a></div>';
        }).join('');
      z.puntos.forEach(function(p, i){
        var pin = document.createElement('div');
        pin.className = 'loc-pin' + (i === 0 ? ' cerca' : '');
        pin.style.left = p.x + '%';
        pin.style.top = p.y + '%';
        pin.style.animationDelay = (i * 90) + 'ms';
        pins.appendChild(pin);
      });
    }
    document.getElementById('loc-form').addEventListener('submit', function(e){
      e.preventDefault(); pintar(document.getElementById('loc-q').value);
    });
    document.getElementById('loc-q').addEventListener('input', function(e){
      if(norm(e.target.value).length >= 3) pintar(e.target.value);
    });
  })();

  /* ---------- newsletter ---------- */
  /* Hoy es una demo: valida y agradece, no manda nada a ningún lado.
     Al pasar a Shopify, el form apunta a /contact con form_type="customer" y el
     perfil viaja como contact[tags], que es lo que permite segmentar después. */
  (function(){
    var form = document.getElementById('news-form');
    if(!form) return;
    var msg = document.getElementById('news-msg');
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var email = document.getElementById('news-email').value.trim();
      var perfil = form.querySelector('input[name="perfil"]:checked');
      if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ msg.textContent = 'Revisá el email, no parece válido.'; return; }
      if(!perfil){ msg.textContent = 'Elegí desde dónde nos leés así te mandamos lo que te sirve.'; return; }
      msg.textContent = '¡Listo! Te anotamos como "' + perfil.value + '". (Demo: todavía no se envía a ningún lado.)';
      form.querySelector('button[type="submit"]').disabled = true;
    });
  })();

  /* filtro del catalogo */
  (function(){
    var btns = document.querySelectorAll(".cat-filtro");
    if(!btns.length) return;
    var prods = document.querySelectorAll(".prod");
    btns.forEach(function(b){
      b.addEventListener("click", function(){
        var f = b.getAttribute("data-f");
        document.querySelector(".cat-filtro.on").classList.remove("on");
        b.classList.add("on");
        prods.forEach(function(p){
          p.style.display = (f === "todo" || p.getAttribute("data-cat") === f) ? "" : "none";
        });
      });
    });
  })();

  /* el hero arranca con las fotos apenas ampliadas y se asientan al cargar */
  requestAnimationFrame(function(){
    setTimeout(function(){
      var h = document.querySelector('.hero');
      if(h) h.classList.add('on');
    }, 60);
  });
})();

</script>

