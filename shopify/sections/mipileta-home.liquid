  /* menú mobile */
  var bar = document.getElementById('topbar');
  document.getElementById('hamburger').addEventListener('click', function(){
    bar.classList.toggle('nav-open');
  });
  document.querySelectorAll('#topnav a').forEach(function(a){
    a.addEventListener('click', function(){ bar.classList.remove('nav-open'); });
  });

  /* 100vw incluye la barra de scroll: compensamos los elementos fixed */
  function fixWidths(){
    var sb = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.setProperty('--vw', document.documentElement.clientWidth + 'px');
    document.documentElement.style.setProperty('--fixoff', (sb/2) + 'px');
  }
  fixWidths();
  window.addEventListener('resize', fixWidths);

  /* el marquee necesita el contenido duplicado para que el loop no salte */
  var track = document.getElementById('strip-track');
  if(track) track.innerHTML = track.innerHTML + track.innerHTML;

  /* apariciones al scrollear */
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold:.14, rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.rv').forEach(function(el, i){
    el.style.transitionDelay = (i % 4 * 90) + 'ms';
    io.observe(el);
  });

