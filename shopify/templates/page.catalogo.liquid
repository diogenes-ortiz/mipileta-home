{%- comment -%}
  templates/page.catalogo.liquid — el catálogo, a pantalla completa.
  Mismo criterio que la home: `layout none` deja afuera el header, el footer y
  el CSS del tema. content_for_header es obligatorio.
{%- endcomment -%}
{% layout none %}<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title | default: 'Catálogo' }} — {{ shop.name }}</title>
  <meta name="description" content="Catálogo completo de Mi Pileta: piletas de cocina, bachas de baño, lavaderos, piletones, accesorios y repuestos en acero inoxidable.">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;700&family=Raleway:wght@200;300;400;700&display=swap" rel="stylesheet">
  {{ content_for_header }}
</head>
<body>
  {% section 'mipileta-catalogo' %}
</body>
</html>
